# Pinned toolchain for reproducible package builds.
# Shared by the Linux (bash) and Windows (PowerShell) build scripts and by the workflows.
# Format: plain KEY=VALUE lines, no quotes, no shell expansion. Bump one thing per PR.

# Where the AirLLM source comes from by default.
UPSTREAM_REPO=lyogavin/airllm
FORK_REPO=RudraLabs-dev/airllm

# Self-contained Python from astral-sh/python-build-standalone (no dependency on distro Python).
# Release list + SHA256SUMS: https://github.com/astral-sh/python-build-standalone/releases
PYTHON_VERSION=3.12.15
PBS_RELEASE=20261013

# PyTorch build bundled in the packages. CPU-only keeps every package well under GitHub's
# 2 GiB release-asset limit; users switch to CUDA after install with `airllm-enable-cuda`.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
DEFAULT_CUDA_VARIANT=cu130

# Linux package builder (goreleaser/nfpm) — produces .deb and .rpm from one config.
NFPM_VERSION=2.48.0

# Package metadata.
PKG_NAME=airllm
PKG_MAINTAINER=RudraLabs <rudralabs.dev@gmail.com>
PKG_VENDOR=RudraLabs
PKG_HOMEPAGE=https://github.com/RudraLabs-dev/airllm-studio
